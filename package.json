  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "build:sim": "node tools/sim/build-sim.mjs",
    "build:mod": "node tools/qc/build-mod.mjs",
    "build:content": "node tools/content/build-content.mjs",
